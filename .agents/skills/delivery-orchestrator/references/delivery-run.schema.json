{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/delivery-orchestrator/delivery-run.schema.json",
  "title": "Delivery orchestrator run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_id",
    "request_sha256",
    "repo_id",
    "primary_worktree",
    "initial_base_sha",
    "artifact_root",
    "phase",
    "status",
    "current_generation",
    "generations",
    "requirements",
    "plans",
    "implementations",
    "events",
    "updated_at"
  ],
  "properties": {
    "schema": {"const": "delivery-run/v1"},
    "work_id": {"$ref": "#/$defs/workId"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "repo_id": {"$ref": "#/$defs/sha256"},
    "primary_worktree": {"type": "string", "minLength": 1},
    "initial_base_sha": {"$ref": "#/$defs/gitSha"},
    "artifact_root": {"$ref": "#/$defs/normalizedPath"},
    "phase": {"$ref": "#/$defs/phase"},
    "status": {"$ref": "#/$defs/status"},
    "current_generation": {"type": "integer", "minimum": 1},
    "generations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/generation"}},
    "requirements": {"$ref": "#/$defs/requirementsSet"},
    "plans": {"$ref": "#/$defs/planSet"},
    "implementations": {"$ref": "#/$defs/implementationSet"},
    "knowledge_gate": {"$ref": "#/$defs/knowledgeGate"},
    "work_kind": {"enum": ["standard", "bug"]},
    "bugs": {"$ref": "#/$defs/bugSet"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "complete"}}, "required": ["phase"]},
      "then": {"properties": {"status": {"const": "complete"}}}
    },
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"phase": {"const": "complete"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "evidenceRef": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "workId": {"type": "string", "pattern": "^(?=[a-z0-9-]{3,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "bugId": {"type": "string", "pattern": "^(?=.{7,64}$)bug-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "normalizedPath": {
      "type": "string",
      "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/:\\\\]+)(?:/(?!(?:\\.{1,2})(?:/|$))[^/:\\\\]+)*$"
    },
    "phase": {"enum": ["workspace", "requirements", "planning", "implementation", "knowledge", "complete"]},
    "status": {"enum": ["active", "awaiting_user", "blocked", "complete"]},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "canonical_worktree", "worktree_key", "branch", "base_sha", "status", "created_at"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "canonical_worktree": {"type": "string", "minLength": 1},
        "worktree_key": {"$ref": "#/$defs/sha256"},
        "branch": {"type": "string", "pattern": "^delivery/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "base_sha": {"$ref": "#/$defs/gitSha"},
        "status": {"enum": ["reserved", "ready", "blocked"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifactRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "approval_evidence_refs"],
      "properties": {
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "Ready"},
        "approval_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "requirementsSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_path", "revisions"],
      "properties": {
        "current_path": {"oneOf": [{"$ref": "#/$defs/normalizedPath"}, {"type": "null"}]},
        "revisions": {"type": "array", "items": {"$ref": "#/$defs/artifactRevision"}}
      }
    },
    "planRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_path", "candidate_revision", "payload_sha256", "status", "approval_evidence_refs"],
      "properties": {
        "handoff_path": {"$ref": "#/$defs/normalizedPath"},
        "candidate_revision": {"type": "string", "minLength": 1},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "Ready"},
        "approval_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "planSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_handoff_path", "revisions"],
      "properties": {
        "current_handoff_path": {"oneOf": [{"$ref": "#/$defs/normalizedPath"}, {"type": "null"}]},
        "revisions": {"type": "array", "items": {"$ref": "#/$defs/planRevision"}}
      }
    },
    "implementationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "ledger_ref", "status"],
      "properties": {
        "run_id": {"$ref": "#/$defs/sha256"},
        "ledger_ref": {"$ref": "#/$defs/evidenceRef"},
        "status": {"enum": ["Active", "Complete", "Awaiting upstream reapproval", "Blocked"]},
        "bug_verification_ref": {"oneOf": [{"$ref": "#/$defs/evidenceRef"}, {"type": "null"}]},
        "bug_verification_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "bug_verification_result": {"oneOf": [{"enum": ["verified", "partial", "failed"]}, {"type": "null"}]}
      }
    },
    "implementationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_run_id", "runs"],
      "properties": {
        "current_run_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "runs": {"type": "array", "items": {"$ref": "#/$defs/implementationRun"}}
      }
    },
    "knowledgePromotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promotion_id", "stage", "candidate_ref", "payload_sha256", "receipt_path", "receipt_sha256", "approval_evidence", "formal_paths", "status"],
      "properties": {
        "promotion_id": {"type": "string", "pattern": "^promotion-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "stage": {"enum": ["requirements", "planning", "implementation", "bug"]},
        "candidate_ref": {"type": "string", "pattern": "^knowledge:candidates/promotion-[a-z0-9]+(?:-[a-z0-9]+)*/candidate\\.json$"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_path": {"$ref": "#/$defs/normalizedPath"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "approval_evidence": {"$ref": "#/$defs/evidenceRef"},
        "formal_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/normalizedPath"}
        },
        "status": {"const": "Ready"}
      }
    },
    "knowledgeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge_snapshot_before", "knowledge_snapshot_after", "candidate_ref", "payload_sha256"],
      "properties": {
        "knowledge_snapshot_before": {"$ref": "#/$defs/sha256"},
        "knowledge_snapshot_after": {"$ref": "#/$defs/sha256"},
        "candidate_ref": {"type": "string", "pattern": "^knowledge:candidates/promotion-[a-z0-9]+(?:-[a-z0-9]+)*/candidate\\.json$"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "knowledgeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "enabled_at", "candidate_ref", "candidate_payload_sha256", "knowledge_snapshot_id", "knowledge_post_snapshot_id", "product_snapshot_id", "outcome_path", "outcome_sha256", "current_promotion_id", "promotions", "review"],
      "properties": {
        "policy": {"const": "required"},
        "enabled_at": {"type": "string", "format": "date-time"},
        "candidate_ref": {"oneOf": [{"type": "string", "pattern": "^knowledge:candidates/promotion-[a-z0-9]+(?:-[a-z0-9]+)*/candidate\\.json$"}, {"type": "null"}]},
        "candidate_payload_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "knowledge_snapshot_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "knowledge_post_snapshot_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "product_snapshot_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "outcome_path": {"oneOf": [{"$ref": "#/$defs/normalizedPath"}, {"type": "null"}]},
        "outcome_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "current_promotion_id": {"oneOf": [{"type": "string", "pattern": "^promotion-[a-z0-9]+(?:-[a-z0-9]+)*$"}, {"type": "null"}]},
        "promotions": {"type": "array", "items": {"$ref": "#/$defs/knowledgePromotion"}},
        "review": {"oneOf": [{"$ref": "#/$defs/knowledgeReview"}, {"type": "null"}]}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "kind", "from_phase", "to_phase", "from_status", "to_status", "evidence_refs"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "at": {"type": "string", "format": "date-time"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "from_phase": {"oneOf": [{"$ref": "#/$defs/phase"}, {"type": "null"}]},
        "to_phase": {"$ref": "#/$defs/phase"},
        "from_status": {"oneOf": [{"$ref": "#/$defs/status"}, {"type": "null"}]},
        "to_status": {"$ref": "#/$defs/status"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "bugAssessmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bug_id", "path", "sha256", "markdown_path", "markdown_sha256", "requirements_path", "requirements_sha256", "approval_evidence_refs"],
      "properties": {
        "bug_id": {"$ref": "#/$defs/bugId"},
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "markdown_path": {"$ref": "#/$defs/normalizedPath"},
        "markdown_sha256": {"$ref": "#/$defs/sha256"},
        "requirements_path": {"$ref": "#/$defs/normalizedPath"},
        "requirements_sha256": {"$ref": "#/$defs/sha256"},
        "approval_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "deferredBug": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "bug_id", "relation", "status", "host_evidence_refs", "sensitive", "redacted_summary", "human_reviewer", "assessment_path", "assessment_sha256", "assessment_markdown_path", "assessment_markdown_sha256", "inbox_ref"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "bug_id": {"$ref": "#/$defs/bugId"},
        "relation": {"enum": ["current-scope", "affecting-current-work", "unrelated"]},
        "status": {"enum": ["pending", "materialized"]},
        "host_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
        "sensitive": {"type": "boolean"},
        "redacted_summary": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "human_reviewer": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "assessment_path": {"oneOf": [{"$ref": "#/$defs/normalizedPath"}, {"type": "null"}]},
        "assessment_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "assessment_markdown_path": {"oneOf": [{"$ref": "#/$defs/normalizedPath"}, {"type": "null"}]},
        "assessment_markdown_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "inbox_ref": {"oneOf": [{"$ref": "#/$defs/evidenceRef"}, {"type": "null"}]}
      }
    },
    "bugVerificationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bug_id", "path", "sha256", "result"],
      "properties": {
        "bug_id": {"$ref": "#/$defs/bugId"},
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "result": {"enum": ["verified", "partial", "failed"]}
      }
    },
    "bugSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_bug_id", "assessments", "deferred", "verification"],
      "properties": {
        "primary_bug_id": {"oneOf": [{"$ref": "#/$defs/bugId"}, {"type": "null"}]},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/bugAssessmentBinding"}},
        "deferred": {"type": "array", "items": {"$ref": "#/$defs/deferredBug"}},
        "verification": {"oneOf": [{"$ref": "#/$defs/bugVerificationBinding"}, {"type": "null"}]}
      }
    }
  },
  "x-phase-transitions": {
    "workspace": ["workspace", "requirements"],
    "requirements": ["requirements", "planning"],
    "planning": ["planning", "requirements", "implementation"],
    "implementation": ["implementation", "planning", "knowledge", "complete"],
    "knowledge": ["knowledge", "implementation", "complete"],
    "complete": []
  },
  "x-status-transitions": {
    "active": ["active", "awaiting_user", "blocked", "complete"],
    "awaiting_user": ["awaiting_user", "active", "blocked", "complete"],
    "blocked": ["blocked", "active"],
    "complete": []
  }
}
