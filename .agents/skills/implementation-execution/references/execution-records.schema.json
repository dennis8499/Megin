{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/implementation-execution/execution-records.schema.json",
  "title": "Implementation execution records",
  "oneOf": [
    {"$ref": "#/$defs/ledger"},
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/reviewReport"},
    {"$ref": "#/$defs/breaker"},
    {"$ref": "#/$defs/bugVerification"},
    {"$ref": "#/$defs/implementationOutcome"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "srcId": {"type": "string", "pattern": "^SRC-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "bugId": {"type": "string", "pattern": "^bug-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "normalizedPath": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "state": {
      "enum": [
        "Preflight",
        "Executing",
        "Verifying",
        "Reviewing",
        "Fixing",
        "Complete",
        "Awaiting upstream reapproval",
        "Blocked"
      ]
    },
    "wpState": {"enum": ["Pending", "Executing", "Verified", "Invalidated", "Blocked"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "canonical_worktree", "worktree_key", "branch", "initial_base_sha", "run_id"],
      "properties": {
        "repo_id": {"$ref": "#/$defs/sha256"},
        "canonical_worktree": {"type": "string", "minLength": 1},
        "worktree_key": {"$ref": "#/$defs/sha256"},
        "branch": {"type": "string", "minLength": 1},
        "initial_base_sha": {"$ref": "#/$defs/gitSha"},
        "run_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "candidate_revision", "state", "wp_states", "state_history"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "candidate_revision": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "wp_states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/wpState"}
        },
        "state_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateTransition"}}
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "from", "to", "evidence_refs"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "from": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
        "to": {"$ref": "#/$defs/state"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "binding",
        "handoff_path",
        "capability_evidence_refs",
        "baseline_evidence_refs",
        "attempts",
        "current_attempt_id"
      ],
      "properties": {
        "schema": {"const": "implementation-ledger/v1"},
        "run_id": {"$ref": "#/$defs/sha256"},
        "binding": {"$ref": "#/$defs/binding"},
        "handoff_path": {"type": "string", "minLength": 1},
        "capability_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "baseline_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
        "current_attempt_id": {"type": "string", "minLength": 1}
      }
    },
    "hashEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repo_id",
        "worktree_key",
        "base_sha",
        "head_sha",
        "ready_hashes",
        "source_hashes",
        "tracked_diff_sha256",
        "unignored_files",
        "snapshot_id"
      ],
      "properties": {
        "schema": {"const": "implementation-snapshot/v1"},
        "repo_id": {"$ref": "#/$defs/sha256"},
        "worktree_key": {"$ref": "#/$defs/sha256"},
        "base_sha": {"$ref": "#/$defs/gitSha"},
        "head_sha": {"$ref": "#/$defs/gitSha"},
        "ready_hashes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hashEntry"}},
        "source_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashEntry"}},
        "tracked_diff_sha256": {"$ref": "#/$defs/sha256"},
        "unignored_files": {"type": "array", "items": {"$ref": "#/$defs/fileEntry"}},
        "snapshot_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "commandOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "outcome",
        "exit_code",
        "failure_count",
        "skipped_count",
        "output_ref",
        "not_run_reason"
      ],
      "properties": {
        "command_id": {"type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "outcome": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "exit_code": {"type": ["integer", "null"]},
        "failure_count": {"type": ["integer", "null"], "minimum": 0},
        "skipped_count": {"type": ["integer", "null"], "minimum": 0},
        "output_ref": {"type": ["string", "null"]},
        "not_run_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "exit_code": {"const": 0},
              "failure_count": {"const": 0},
              "skipped_count": {"const": 0},
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "failed"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "blocked"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "not_run"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "exit_code": {"type": "null"},
              "failure_count": {"type": "null"},
              "skipped_count": {"type": "null"},
              "not_run_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "reviewerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "fresh_session",
        "read_only",
        "implementation_conversation_received",
        "delegation_used",
        "write_actions"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "fresh_session": {"const": true},
        "read_only": {"const": true},
        "implementation_conversation_received": {"const": false},
        "delegation_used": {"const": false},
        "write_actions": {"const": false}
      }
    },
    "findingKeyInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "source_refs", "affected_loci", "required_outcome"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/srcId"}},
        "affected_loci": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_outcome": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_key",
        "key_inputs",
        "severity",
        "blocking",
        "message",
        "evidence_refs",
        "wp_refs",
        "bdd_refs",
        "test_refs"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "finding_key": {"$ref": "#/$defs/sha256"},
        "key_inputs": {"$ref": "#/$defs/findingKeyInputs"},
        "severity": {"enum": ["advisory", "low", "medium", "high", "critical"]},
        "blocking": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "wp_refs": {"type": "array", "items": {"type": "string", "pattern": "^WP-"}},
        "bdd_refs": {"type": "array", "items": {"type": "string", "pattern": "^BDD-"}},
        "test_refs": {"type": "array", "items": {"type": "string", "pattern": "^TEST-"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "obligation_ref", "bdd_refs", "test_refs", "wp_refs", "code_evidence", "result"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/srcId"},
        "obligation_ref": {"type": "string", "minLength": 1},
        "bdd_refs": {"type": "array", "items": {"type": "string", "pattern": "^BDD-"}},
        "test_refs": {"type": "array", "items": {"type": "string", "pattern": "^TEST-"}},
        "wp_refs": {"type": "array", "items": {"type": "string", "pattern": "^WP-"}},
        "code_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result": {"enum": ["covered", "not_covered", "blocked"]}
      }
    },
    "bugAssessmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "markdown_path", "markdown_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "markdown_path": {"$ref": "#/$defs/normalizedPath"},
        "markdown_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bugVerificationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_path", "candidate_revision", "verification_target"],
      "properties": {
        "handoff_path": {"$ref": "#/$defs/normalizedPath"},
        "candidate_revision": {"type": "string", "minLength": 1},
        "verification_target": {"enum": ["verified", "partial"]}
      }
    },
    "symptomEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_ref", "status", "evidence_refs"],
      "properties": {
        "command_ref": {
          "oneOf": [
            {"type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9._-]*$"},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["present", "absent", "inconclusive", "not-run"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "contractEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bdd_refs", "test_refs", "red_evidence_refs", "green_evidence_refs"],
      "properties": {
        "bdd_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^BDD-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
        "test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TEST-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
        "red_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "green_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "bugVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "bug_id",
        "work_id",
        "result",
        "plan",
        "assessment",
        "original_reproduction",
        "regression",
        "proxy",
        "full_verification",
        "residual_risks",
        "follow_up",
        "implementation_review_ref",
        "summary",
        "created_at"
      ],
      "properties": {
        "schema": {"const": "bug-verification/v1"},
        "bug_id": {"$ref": "#/$defs/bugId"},
        "work_id": {"type": "string", "pattern": "^(?=[a-z0-9-]{3,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "result": {"enum": ["verified", "partial", "failed"]},
        "plan": {"$ref": "#/$defs/bugVerificationPlan"},
        "assessment": {"$ref": "#/$defs/bugAssessmentBinding"},
        "original_reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_fix", "post_fix"],
          "properties": {
            "pre_fix": {"$ref": "#/$defs/symptomEvidence"},
            "post_fix": {"$ref": "#/$defs/symptomEvidence"}
          }
        },
        "regression": {"$ref": "#/$defs/contractEvidence"},
        "proxy": {"$ref": "#/$defs/contractEvidence"},
        "full_verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commandOutcome"}},
        "residual_risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "follow_up": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "implementation_review_ref": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1, "format": "date-time"}
      }
    },
    "outcomeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "summary"],
      "properties": {
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "outcomeVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "outcome", "evidence_refs"],
      "properties": {
        "command_id": {"type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "outcome": {"enum": ["passed", "failed", "not_run"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "outcomeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence_refs", "report_ref", "report_sha256"],
      "properties": {
        "verdict": {"enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "pattern": "^review:fresh-review:[a-z0-9][a-z0-9._-]{2,127}$"}
        },
        "report_ref": {"type": "string", "pattern": "^reviews/[a-z0-9][a-z0-9._-]{2,127}/report\\.json$"},
        "report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcomeMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bugOutcomeDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bug_id", "original_reproduction", "regression", "proxy", "residual_risks", "follow_up", "implementation_review_ref"],
      "properties": {
        "bug_id": {"$ref": "#/$defs/bugId"},
        "original_reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_fix", "post_fix"],
          "properties": {
            "pre_fix": {"$ref": "#/$defs/symptomEvidence"},
            "post_fix": {"$ref": "#/$defs/symptomEvidence"}
          }
        },
        "regression": {"$ref": "#/$defs/contractEvidence"},
        "proxy": {"$ref": "#/$defs/contractEvidence"},
        "residual_risks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "follow_up": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "implementation_review_ref": {"type": "string", "minLength": 1}
      }
    },
    "implementationOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "work_id", "implementation_run_id", "revision", "work_kind", "result", "summary", "changes", "verification", "review", "known_deviations", "knowledge_decision", "bug_verification_ref", "bug", "markdown", "created_at"],
      "properties": {
        "schema": {"const": "implementation-outcome/v1"},
        "work_id": {"type": "string", "pattern": "^(?=[a-z0-9-]{3,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "implementation_run_id": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1},
        "work_kind": {"enum": ["standard", "bug"]},
        "result": {"enum": ["complete", "verified", "partial", "failed"]},
        "summary": {"type": "string", "minLength": 1},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcomeChange"}},
        "verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcomeVerification"}},
        "review": {"$ref": "#/$defs/outcomeReview"},
        "known_deviations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "knowledge_decision": {"enum": ["change", "no-change"]},
        "bug_verification_ref": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "bug": {"oneOf": [{"$ref": "#/$defs/bugOutcomeDetails"}, {"type": "null"}]},
        "markdown": {"$ref": "#/$defs/outcomeMarkdown"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"work_kind": {"const": "standard"}}, "required": ["work_kind"]},
          "then": {
            "properties": {
              "result": {"const": "complete"},
              "bug_verification_ref": {"type": "null"},
              "bug": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"work_kind": {"const": "bug"}}, "required": ["work_kind"]},
          "then": {
            "properties": {
              "result": {"enum": ["verified", "partial", "failed"]},
              "bug_verification_ref": {"type": "string", "minLength": 1},
              "bug": {"$ref": "#/$defs/bugOutcomeDetails"}
            }
          }
        }
      ]
    },
    "reviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "round",
        "verdict",
        "snapshot_before",
        "snapshot_after",
        "attestation",
        "command_outcomes",
        "raw_output_refs",
        "requirement_coverage",
        "findings",
        "summary"
      ],
      "properties": {
        "schema": {"const": "implementation-review/v1"},
        "logical_ref": {"type": "string", "pattern": "^review:fresh-review:[a-z0-9][a-z0-9._-]{2,127}$"},
        "round": {"type": "integer", "minimum": 1},
        "verdict": {"enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"]},
        "snapshot_before": {"$ref": "#/$defs/sha256"},
        "snapshot_after": {"$ref": "#/$defs/sha256"},
        "attestation": {"$ref": "#/$defs/reviewerAttestation"},
        "command_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commandOutcome"}},
        "raw_output_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requirement_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "bug_verification_ref": {"type": "string", "minLength": 1},
        "bug_verification_result": {"enum": ["verified", "partial", "failed"]},
        "knowledge_snapshot_before": {"$ref": "#/$defs/sha256"},
        "knowledge_snapshot_after": {"$ref": "#/$defs/sha256"},
        "knowledge_candidate_ref": {"type": "string", "pattern": "^knowledge:candidates/promotion-[a-z0-9]+(?:-[a-z0-9]+)*/candidate\\.json$"},
        "knowledge_candidate_payload_sha256": {"$ref": "#/$defs/sha256"},
        "summary": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["knowledge_snapshot_before"]},
              {"required": ["knowledge_snapshot_after"]},
              {"required": ["knowledge_candidate_ref"]},
              {"required": ["knowledge_candidate_payload_sha256"]}
            ]
          },
          "then": {
            "required": [
              "knowledge_snapshot_before",
              "knowledge_snapshot_after",
              "knowledge_candidate_ref",
              "knowledge_candidate_payload_sha256"
            ]
          }
        }
      ]
    },
    "breakerFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_key", "consecutive_unresolved_rounds", "no_progress_rounds", "last_evidence_sha256"],
      "properties": {
        "finding_key": {"$ref": "#/$defs/sha256"},
        "consecutive_unresolved_rounds": {"type": "integer", "minimum": 1},
        "no_progress_rounds": {"type": "integer", "minimum": 0},
        "last_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "breaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "findings", "global_no_progress_rounds"],
      "properties": {
        "schema": {"const": "implementation-breaker/v1"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/breakerFinding"}},
        "global_no_progress_rounds": {"type": "integer", "minimum": 0}
      }
    }
  },
  "x-state-transitions": {
    "Preflight": ["Executing", "Awaiting upstream reapproval", "Blocked"],
    "Executing": ["Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Verifying": ["Reviewing", "Fixing", "Awaiting upstream reapproval", "Blocked"],
    "Reviewing": ["Complete", "Fixing", "Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Fixing": ["Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Complete": [],
    "Awaiting upstream reapproval": [],
    "Blocked": []
  },
  "x-wp-state-transitions": {
    "Pending": ["Executing", "Blocked"],
    "Executing": ["Verified", "Blocked"],
