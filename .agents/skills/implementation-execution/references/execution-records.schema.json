{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/implementation-execution/execution-records.schema.json",
  "title": "Implementation execution records",
  "oneOf": [
    {"$ref": "#/$defs/ledger"},
    {"$ref": "#/$defs/snapshot"},
    {"$ref": "#/$defs/reviewReport"},
    {"$ref": "#/$defs/breaker"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gitSha": {"type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
    "srcId": {"type": "string", "pattern": "^SRC-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "state": {
      "enum": [
        "Preflight",
        "Executing",
        "Verifying",
        "Reviewing",
        "Fixing",
        "Complete",
        "Awaiting upstream reapproval",
        "Blocked"
      ]
    },
    "wpState": {"enum": ["Pending", "Executing", "Verified", "Invalidated", "Blocked"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "canonical_worktree", "worktree_key", "branch", "initial_base_sha", "run_id"],
      "properties": {
        "repo_id": {"$ref": "#/$defs/sha256"},
        "canonical_worktree": {"type": "string", "minLength": 1},
        "worktree_key": {"$ref": "#/$defs/sha256"},
        "branch": {"type": "string", "minLength": 1},
        "initial_base_sha": {"$ref": "#/$defs/gitSha"},
        "run_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "candidate_revision", "state", "wp_states", "state_history"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "candidate_revision": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/state"},
        "wp_states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/wpState"}
        },
        "state_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stateTransition"}}
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "from", "to", "evidence_refs"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "from": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
        "to": {"$ref": "#/$defs/state"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "binding",
        "handoff_path",
        "capability_evidence_refs",
        "baseline_evidence_refs",
        "attempts",
        "current_attempt_id"
      ],
      "properties": {
        "schema": {"const": "implementation-ledger/v1"},
        "run_id": {"$ref": "#/$defs/sha256"},
        "binding": {"$ref": "#/$defs/binding"},
        "handoff_path": {"type": "string", "minLength": 1},
        "capability_evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "baseline_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
        "current_attempt_id": {"type": "string", "minLength": 1}
      }
    },
    "hashEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repo_id",
        "worktree_key",
        "base_sha",
        "head_sha",
        "ready_hashes",
        "source_hashes",
        "tracked_diff_sha256",
        "unignored_files",
        "snapshot_id"
      ],
      "properties": {
        "schema": {"const": "implementation-snapshot/v1"},
        "repo_id": {"$ref": "#/$defs/sha256"},
        "worktree_key": {"$ref": "#/$defs/sha256"},
        "base_sha": {"$ref": "#/$defs/gitSha"},
        "head_sha": {"$ref": "#/$defs/gitSha"},
        "ready_hashes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hashEntry"}},
        "source_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hashEntry"}},
        "tracked_diff_sha256": {"$ref": "#/$defs/sha256"},
        "unignored_files": {"type": "array", "items": {"$ref": "#/$defs/fileEntry"}},
        "snapshot_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "commandOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "outcome",
        "exit_code",
        "failure_count",
        "skipped_count",
        "output_ref",
        "not_run_reason"
      ],
      "properties": {
        "command_id": {"type": "string", "pattern": "^CMD-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "outcome": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "exit_code": {"type": ["integer", "null"]},
        "failure_count": {"type": ["integer", "null"], "minimum": 0},
        "skipped_count": {"type": ["integer", "null"], "minimum": 0},
        "output_ref": {"type": ["string", "null"]},
        "not_run_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "passed"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "exit_code": {"const": 0},
              "failure_count": {"const": 0},
              "skipped_count": {"const": 0},
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "failed"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "blocked"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "output_ref": {"type": "string", "minLength": 1},
              "not_run_reason": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "not_run"}}, "required": ["outcome"]},
          "then": {
            "properties": {
              "exit_code": {"type": "null"},
              "failure_count": {"type": "null"},
              "skipped_count": {"type": "null"},
              "not_run_reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "reviewerAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "fresh_session",
        "read_only",
        "implementation_conversation_received",
        "delegation_used",
        "write_actions"
      ],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "fresh_session": {"const": true},
        "read_only": {"const": true},
        "implementation_conversation_received": {"const": false},
        "delegation_used": {"const": false},
        "write_actions": {"const": false}
      }
    },
    "findingKeyInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "source_refs", "affected_loci", "required_outcome"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/srcId"}},
        "affected_loci": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_outcome": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "finding_key",
        "key_inputs",
        "severity",
        "blocking",
        "message",
        "evidence_refs",
        "wp_refs",
        "bdd_refs",
        "test_refs"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "finding_key": {"$ref": "#/$defs/sha256"},
        "key_inputs": {"$ref": "#/$defs/findingKeyInputs"},
        "severity": {"enum": ["advisory", "low", "medium", "high", "critical"]},
        "blocking": {"type": "boolean"},
        "message": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "wp_refs": {"type": "array", "items": {"type": "string", "pattern": "^WP-"}},
        "bdd_refs": {"type": "array", "items": {"type": "string", "pattern": "^BDD-"}},
        "test_refs": {"type": "array", "items": {"type": "string", "pattern": "^TEST-"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "obligation_ref", "bdd_refs", "test_refs", "wp_refs", "code_evidence", "result"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/srcId"},
        "obligation_ref": {"type": "string", "minLength": 1},
        "bdd_refs": {"type": "array", "items": {"type": "string", "pattern": "^BDD-"}},
        "test_refs": {"type": "array", "items": {"type": "string", "pattern": "^TEST-"}},
        "wp_refs": {"type": "array", "items": {"type": "string", "pattern": "^WP-"}},
        "code_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result": {"enum": ["covered", "not_covered", "blocked"]}
      }
    },
    "reviewReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "round",
        "verdict",
        "snapshot_before",
        "snapshot_after",
        "attestation",
        "command_outcomes",
        "raw_output_refs",
        "requirement_coverage",
        "findings",
        "summary"
      ],
      "properties": {
        "schema": {"const": "implementation-review/v1"},
        "round": {"type": "integer", "minimum": 1},
        "verdict": {"enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"]},
        "snapshot_before": {"$ref": "#/$defs/sha256"},
        "snapshot_after": {"$ref": "#/$defs/sha256"},
        "attestation": {"$ref": "#/$defs/reviewerAttestation"},
        "command_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commandOutcome"}},
        "raw_output_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "requirement_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "breakerFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_key", "consecutive_unresolved_rounds", "no_progress_rounds", "last_evidence_sha256"],
      "properties": {
        "finding_key": {"$ref": "#/$defs/sha256"},
        "consecutive_unresolved_rounds": {"type": "integer", "minimum": 1},
        "no_progress_rounds": {"type": "integer", "minimum": 0},
        "last_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "breaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "findings", "global_no_progress_rounds"],
      "properties": {
        "schema": {"const": "implementation-breaker/v1"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/breakerFinding"}},
        "global_no_progress_rounds": {"type": "integer", "minimum": 0}
      }
    }
  },
  "x-state-transitions": {
    "Preflight": ["Executing", "Awaiting upstream reapproval", "Blocked"],
    "Executing": ["Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Verifying": ["Reviewing", "Fixing", "Awaiting upstream reapproval", "Blocked"],
    "Reviewing": ["Complete", "Fixing", "Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Fixing": ["Verifying", "Awaiting upstream reapproval", "Blocked"],
    "Complete": [],
    "Awaiting upstream reapproval": [],
    "Blocked": []
  },
  "x-wp-state-transitions": {
    "Pending": ["Executing", "Blocked"],
    "Executing": ["Verified", "Blocked"],
    "Verified": ["Invalidated"],
    "Invalidated": ["Executing", "Blocked"],
    "Blocked": []
  },
  "x-terminal-ordering": [
    "review_received",
    "snapshot_recomputed_before_persist",
    "snapshot_matched_before_persist",
    "report_persisted",
    "snapshot_recomputed_after_persist",
    "snapshot_matched_after_persist",
    "complete_appended"
  ]
}
