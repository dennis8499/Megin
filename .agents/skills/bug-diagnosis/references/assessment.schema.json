{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/bug-diagnosis/assessment.schema.json",
  "title": "bug-assessment/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bug_id",
    "revision",
    "markdown",
    "source",
    "observed_behavior",
    "expected_behavior",
    "impact",
    "verdict",
    "severity",
    "reproduction",
    "root_cause",
    "hypotheses",
    "active_hypothesis_id",
    "risk",
    "disposition",
    "evidence_refs",
    "next_action",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "bug-assessment/v1"},
    "bug_id": {"$ref": "#/$defs/bugId"},
    "revision": {"type": "integer", "minimum": 1},
    "markdown": {"$ref": "#/$defs/pathHash"},
    "source": {"$ref": "#/$defs/source"},
    "observed_behavior": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["confirmed", "likely", "not-a-bug", "insufficient-evidence"]},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "reproduction": {"$ref": "#/$defs/reproduction"},
    "root_cause": {"$ref": "#/$defs/rootCause"},
    "hypotheses": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "active_hypothesis_id": {
      "oneOf": [
        {"type": "string", "pattern": "^H-[0-9]{3}$"},
        {"type": "null"}
      ]
    },
    "risk": {"$ref": "#/$defs/risk"},
    "disposition": {"enum": ["delivery", "standard-feature", "closed", "current-run", "upstream-reapproval", "deferred-inbox", "blocked"]},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
    "next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"root_cause": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]}}, "required": ["root_cause"]},
      "else": {"properties": {"hypotheses": {"minItems": 3, "maxItems": 5}}}
    },
    {
      "if": {"properties": {"risk": {"properties": {"security_privacy_or_data_risk": {"const": true}}, "required": ["security_privacy_or_data_risk"]}}, "required": ["risk"]},
      "then": {
        "properties": {
          "risk": {
            "properties": {
              "redacted_summary": {"type": "string", "minLength": 1},
              "secure_evidence_refs": {"minItems": 1},
              "human_reviewer": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bugId": {"type": "string", "pattern": "^(?=.{7,64}$)bug-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "workId": {"type": "string", "pattern": "^(?=[a-z0-9-]{3,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "normalizedPath": {"type": "string", "minLength": 1, "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/:\\\\]+)(?:/(?!(?:\\.{1,2})(?:/|$))[^/:\\\\]+)*$"},
    "evidenceRef": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,255}$"},
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/normalizedPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "work_id", "reported_by", "evidence_refs"],
      "properties": {
        "relation": {"enum": ["intake", "current-scope", "affecting-current-work", "unrelated"]},
        "work_id": {"oneOf": [{"$ref": "#/$defs/workId"}, {"type": "null"}]},
        "reported_by": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "symptom_oracle", "steps", "sample", "command_refs", "evidence_refs"],
      "properties": {
        "status": {"enum": ["reproduced", "intermittent", "not-reproduced", "not-attempted"]},
        "symptom_oracle": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sample": {"type": "string", "minLength": 1},
        "command_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "rootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "summary", "evidence_refs"],
      "properties": {
        "status": {"enum": ["confirmed", "hypothesized", "unknown"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "rank", "statement", "variable", "prediction", "falsifier", "outcome", "evidence_refs"],
      "properties": {
        "hypothesis_id": {"type": "string", "pattern": "^H-[0-9]{3}$"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 5},
        "statement": {"type": "string", "minLength": 1},
        "variable": {"type": "string", "minLength": 1},
        "prediction": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["untested", "testing", "supported", "falsified"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_privacy_or_data_risk", "redacted_summary", "secure_evidence_refs", "human_reviewer"],
      "properties": {
        "security_privacy_or_data_risk": {"type": "boolean"},
        "redacted_summary": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "secure_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}},
        "human_reviewer": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    }
  }
}
