{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/bug-diagnosis/closure-status.schema.json",
  "title": "bug-closure-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bug_id",
    "revision",
    "work_scope",
    "assessment",
    "verification",
    "current_disposition",
    "severity",
    "tracking",
    "timebox",
    "blocker",
    "risk_decision",
    "reviewer",
    "required_platforms",
    "platform_evidence",
    "current_observation",
    "closure_evidence",
    "evidence_manifest",
    "previous",
    "transition"
  ],
  "properties": {
    "schema": {"const": "bug-closure-status/v1"},
    "bug_id": {"$ref": "#/$defs/bugId"},
    "revision": {"type": "integer", "minimum": 1},
    "work_scope": {"$ref": "#/$defs/workScope"},
    "assessment": {"$ref": "#/$defs/assessmentBinding"},
    "verification": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/verificationBinding"}]},
    "current_disposition": {
      "enum": [
        "confirmed-open",
        "fixed-verified",
        "evidence-pending",
        "environment-blocked",
        "contract-blocked",
        "accepted-risk",
        "deferred",
        "rejected"
      ]
    },
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "tracking": {"$ref": "#/$defs/tracking"},
    "timebox": {"$ref": "#/$defs/timebox"},
    "blocker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blocker"}]},
    "risk_decision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/riskDecision"}]},
    "reviewer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reviewer"}]},
    "required_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Windows", "Linux"]}},
    "platform_evidence": {"type": "array", "items": {"$ref": "#/$defs/platformEvidence"}},
    "current_observation": {"$ref": "#/$defs/symptomEvidence"},
    "closure_evidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/closureEvidence"}]},
    "evidence_manifest": {"type": "array", "items": {"$ref": "#/$defs/evidenceEntry"}},
    "previous": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/previous"}]},
    "transition": {"$ref": "#/$defs/transition"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bugId": {"type": "string", "pattern": "^(?=.{7,64}$)bug-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "workId": {"type": "string", "pattern": "^(?=[a-z0-9-]{3,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "workScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "bug_ids", "scope_kind"],
      "properties": {
        "work_id": {"$ref": "#/$defs/workId"},
        "bug_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/bugId"}},
        "scope_kind": {"enum": ["single", "common"]}
      }
    },
    "assessmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "markdown_path", "markdown_sha256", "revision"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "markdown_path": {"$ref": "#/$defs/path"},
        "markdown_sha256": {"$ref": "#/$defs/sha256"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "verificationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "path", "sha256"],
      "properties": {
        "result": {"enum": ["verified", "partial", "failed"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "implementation_owner", "next_action", "due_date"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "implementation_owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "due_date": {"$ref": "#/$defs/date"}
      }
    },
    "timebox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t0", "classify_due", "blocker_due", "escalate_due", "decision_due"],
      "properties": {
        "t0": {"$ref": "#/$defs/date"},
        "classify_due": {"$ref": "#/$defs/date"},
        "blocker_due": {"$ref": "#/$defs/date"},
        "escalate_due": {"$ref": "#/$defs/date"},
        "decision_due": {"$ref": "#/$defs/date"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "summary", "missing_capability", "owner", "due_date", "alternative", "escalation_role", "release_blocked", "next_action", "evidence_refs"],
      "properties": {
        "class": {"enum": ["environment", "contract"]},
        "summary": {"type": "string", "minLength": 1},
        "missing_capability": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "due_date": {"$ref": "#/$defs/date"},
        "alternative": {"type": "string", "minLength": 1},
        "escalation_role": {"type": "string", "minLength": 1},
        "release_blocked": {"type": "boolean"},
        "next_action": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identity", "approved_at", "evidence_ref"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "riskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "owner", "reason", "mitigation", "impact_scope", "expires_on", "reopen_condition", "next_review", "approvals"],
      "properties": {
        "decision": {"enum": ["accepted-risk", "deferred", "rejected"]},
        "owner": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "mitigation": {"type": "string", "minLength": 1},
        "impact_scope": {"type": "string", "minLength": 1},
        "expires_on": {"$ref": "#/$defs/date"},
        "reopen_condition": {"type": "string", "minLength": 1},
        "next_review": {"$ref": "#/$defs/date"},
        "approvals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/approval"}}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "role", "scope", "version", "report_path", "report_sha256", "outcome"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "report_path": {"$ref": "#/$defs/path"},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["APPROVED", "CHANGES_REQUIRED", "BLOCKED"]}
      }
    },
    "symptomEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command_ref", "evidence_refs"],
      "properties": {
        "status": {"enum": ["present", "absent", "inconclusive", "not-run"]},
        "command_ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "platformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "outcome", "evidence_refs"],
      "properties": {
        "platform": {"enum": ["Windows", "Linux"]},
        "outcome": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "commandOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_ref", "outcome", "evidence_refs"],
      "properties": {
        "command_ref": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["passed", "failed", "blocked", "not_run"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "closureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_reproduction", "regression", "full_verification"],
      "properties": {
        "original_reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_fix", "post_fix"],
          "properties": {"pre_fix": {"$ref": "#/$defs/symptomEvidence"}, "post_fix": {"$ref": "#/$defs/symptomEvidence"}}
        },
        "regression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["red_evidence_refs", "green_evidence_refs"],
          "properties": {
            "red_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "green_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "full_verification": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commandOutcome"}}
      }
    },
    "evidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "sha256", "preserved"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "preserved": {"type": "boolean"}
      }
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "at", "reason", "evidence_refs"],
      "properties": {
        "from": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "to": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
