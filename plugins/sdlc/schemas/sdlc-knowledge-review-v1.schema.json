{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sdlc/sdlc-knowledge-review-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_id", "reviewer_id", "reviewer_session", "candidate_sha256", "scope", "snapshot_before", "snapshot_after", "status", "test_evidence", "claim_evidence"],
  "properties": {
    "schema": {"const": "sdlc-knowledge-review/v1"}, "work_id": {"type": "string"}, "reviewer_id": {"type": "string"}, "reviewer_session": {"type": "string"}, "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"type": "array", "items": {"type": "string"}}, "snapshot_before": {"type": "string"}, "snapshot_after": {"type": "string"}, "status": {"const": "reviewed"},
    "test_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "status"], "properties": {"command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "verified"]}}, "additionalProperties": true}},
    "claim_evidence": {"type": "array", "items": {"type": "object", "required": ["path", "command", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "verified"]}}, "additionalProperties": true}}
  }
}
