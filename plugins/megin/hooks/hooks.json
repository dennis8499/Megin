{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "statusMessage": "Loading Megin v3 read-only workflow context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/user_prompt_submit.py\"",
            "statusMessage": "Routing the request through Megin v3"
          }
        ]
      }
    ]
  }
}
