#!/bin/sh
set -eu
export PYTHONDONTWRITEBYTECODE=1

python_bin=
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 13) else 1)' >/dev/null 2>&1; then
        python_bin=$candidate
        break
    fi
done

if [ -z "$python_bin" ]; then
    echo "Megin requires Python 3.13+ (python3 or python)" >&2
    exit 127
fi

exec "$python_bin" "$(CDPATH= cd -- "$(dirname -- "$0")/../scripts" && pwd)/megin_v3.py" "$@"
