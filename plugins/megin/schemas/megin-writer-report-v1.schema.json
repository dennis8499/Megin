{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.megin/megin-writer-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_id", "assignment_id", "assignment_sha256", "writer_id", "session_id", "ticket_sha256", "status", "changed_paths", "snapshot"],
  "properties": {
    "schema": {"const": "megin-writer-report/v1"}, "work_id": {"type": "string"}, "assignment_id": {"type": "string"},
    "assignment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "writer_id": {"type": "string"}, "session_id": {"type": "string"}, "ticket_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["completed", "needs_revision", "blocked", "awaiting_upstream"]}, "changed_paths": {"type": "array", "items": {"type": "string"}}, "snapshot": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tests": {"type": "array", "items": {"type": "object", "required": ["command", "status"], "properties": {"command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "verified"]}}, "additionalProperties": true}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "completed"}}}, "then": {"required": ["tests"], "properties": {"tests": {"minItems": 1}}}}]
}
