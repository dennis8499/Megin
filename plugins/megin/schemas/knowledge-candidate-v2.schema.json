{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.megin/knowledge-candidate-v2.schema.json",
  "title": "Portable Megin knowledge candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "work_id", "revision", "scope", "sources", "certainty", "claims", "created_at"],
  "properties": {
    "schema": {"const": "knowledge-candidate/v2"},
    "work_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "string", "pattern": "^candidate-[0-9]+$"},
    "scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "certainty": {"const": "supported"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "content", "redacted", "source_refs", "source_sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 0},
        "content": {"type": ["string", "null"]},
        "redacted": {"type": "boolean"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
