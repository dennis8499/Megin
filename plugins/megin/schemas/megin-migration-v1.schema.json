{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.megin/megin-migration-v1.schema.json",
  "title": "Megin legacy migration result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "repo", "source", "target", "migration_id", "backup", "work_ids", "file_count", "conflicts"],
  "properties": {
    "schema": {"const": "megin-migration/v1"},
    "status": {"enum": ["dry_run", "migrated", "already_migrated", "blocked"]},
    "repo": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/locations"},
    "target": {"$ref": "#/$defs/locations"},
    "migration_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "backup": {"anyOf": [{"$ref": "#/$defs/backup"}, {"type": "null"}]},
    "work_ids": {"type": "array", "items": {"type": "string"}},
    "file_count": {"type": "integer", "minimum": 0},
    "conflicts": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "locations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "state_root"],
      "properties": {"config": {"type": "string"}, "state_root": {"type": ["string", "null"]}}
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "state"],
      "properties": {"config": {"type": "string"}, "state": {"type": ["string", "null"]}}
    }
  }
}
